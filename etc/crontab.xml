<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="vendic_ohdear_check_store_fronts"
             instance="Vendic\OhDear\Cron\CheckStoreFronts"
             method="execute">
            <schedule>0 * * * *</schedule>
        </job>
        <job name="vendic_ohdear_recheck_failed_store_fronts"
             instance="Vendic\OhDear\Cron\RecheckFailedStoreFronts"
             method="execute">
            <schedule>*/2 * * * *</schedule>
        </job>
    </group>
</config>
